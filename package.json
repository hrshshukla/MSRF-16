{
  "name": "mahakal-sanatan-raksha-foundation",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "client",
    "api/db"
  ],
  "scripts": {
    "build:db": "npm run build --workspace api/db",
    "dev": "npm run build:db && CLIENT_PORT=5000 API_PORT=5001 concurrently -n client,api -c cyan,magenta \"npm run dev --workspace client\" \"tsx api/dev.ts\"",
    "build": "npm run typecheck && npm run build --workspace client",
    "typecheck": "npm run build:db && tsc --build && tsc -p api/tsconfig.json --noEmit && npm run typecheck --workspace client",
    "db:push": "npm run push --workspace api/db"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "thread-stream": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.10.0",
    "@workspace/db": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.1.4",
    "drizzle-orm": "0.45.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "drizzle-orm": "0.45.2"
  }
}
